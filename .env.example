# Filoos environment configuration
# Copy this file to .env and adjust values as needed.
#
# All settings should be prefixed with FF_ (e.g. FF_APP_ENV).
# Legacy unprefixed variables (e.g. APP_ENV) are still accepted
# but will be removed in a future release.
#
# IMPORTANT: every variable in this file is REQUIRED to have the FF_
# prefix. pydantic-settings does NOT decode \u escape sequences in .env
# files, so write the literal UTF-8 character for FF_CURRENCY_SYMBOL
# (not \u20b9).

# Application
FF_APP_NAME=Filoos
FF_APP_ENV=production        # development | production | test
FF_DEBUG=false                # MUST be false in production

# Database (Postgres on Neon).
# Use the POOLED endpoint (hostname includes -pooler) for the web service.
FF_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Local dev (SQLite, relative to backend/):
# FF_DATABASE_URL=sqlite:///../data/expenses.db

# Default currency (ISO 4217). Used for accounts and totals.
FF_DEFAULT_CURRENCY=INR

# Currency display symbol (overrides the default derived from the code).
# Leave empty to use the ISO code as a fallback.
# Write the literal character — pydantic-settings reads .env as UTF-8 text.
FF_CURRENCY_SYMBOL=₹

# Forecasting
FF_FORECAST_HISTORY_DAYS=180
FF_FORECAST_CACHE_TTL_SECONDS=300

# Recurring transactions (materialized per-user via API, not at startup)
# FF_RECURRING_AUTO_MATERIALIZE=false

# Sessions / Auth
FF_SESSION_SECRET=change-me
FF_SESSION_MAX_AGE_SECONDS=86400
# FF_SESSION_COOKIE_SECURE=true    # Set to true in production

# Google OAuth
# FF_GOOGLE_CLIENT_ID=
# FF_GOOGLE_CLIENT_SECRET=
# FF_GOOGLE_REDIRECT_URI=

# Security: comma-separated allowed hosts for TrustedHostMiddleware
FF_ALLOWED_HOSTS=localhost,127.0.0.1
