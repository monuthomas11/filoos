# FutureFunds environment configuration
# Copy this file to .env and adjust values as needed.

# Application
APP_NAME=FutureFunds
APP_ENV=development          # development | production
DEBUG=true

# Database (SQLite, relative to backend/)
DATABASE_URL=sqlite:///../data/expenses.db

# Default currency (ISO 4217). Used for accounts and totals.
DEFAULT_CURRENCY=INR

# Currency display symbol (overrides the default derived from the code)
# Leave empty to use the ISO code as a fallback.
CURRENCY_SYMBOL=₹

# Forecasting
FORECAST_HISTORY_DAYS=180
FORECAST_CACHE_TTL_SECONDS=300

# Recurring transactions
RECURRING_AUTO_MATERIALIZE=true   # run on FastAPI startup
