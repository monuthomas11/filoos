{
  "name": "filoos-frontend",
  "private": true,
  "description": "Filoos frontend build (Tailwind CSS).",
  "scripts": {
    "build:css": "tailwindcss --config tailwind.config.js --input app/static/css/app.css --output app/static/css/app.compiled.css --minify",
    "watch:css": "tailwindcss --config tailwind.config.js --input app/static/css/app.css --output app/static/css/app.compiled.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
